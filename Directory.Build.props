<Project>
  <!--
    The product version (<YYYY><MM>.<counter>[-<branch>]) is calculated from Git tags by
    scripts/Get-ProductVersion.ps1 in Directory.Build.targets. Release builds pass it explicitly
    with -p:ProductVersion=<version>.
  -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Andreas Lucas (aka Kili)</Authors>
    <AuthorEmail>andreas.lucas@outlook.com</AuthorEmail>
    <Company>Andreas Lucas</Company>
    <Copyright>Copyright 2026 Andreas Lucas</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/anluca_microsoft/HybridDeviceTagger</PackageProjectUrl>
    <RepositoryUrl>https://github.com/anluca_microsoft/HybridDeviceTagger.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Tags hybrid Active Directory devices in Microsoft Entra ID and securely rotates the directory service credential.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'HybridDeviceTagger'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>

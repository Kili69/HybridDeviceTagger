<Project>
  <PropertyGroup>
    <VersionMajor Condition="'$(VersionMajor)' == ''">0</VersionMajor>
    <VersionMinor Condition="'$(VersionMinor)' == ''">1</VersionMinor>
    <VersionDate Condition="'$(VersionDate)' == ''">20261005</VersionDate>
    <VersionCounter Condition="'$(VersionCounter)' == ''">2</VersionCounter>
    <Version>$(VersionMajor).$(VersionMinor).$(VersionDate).$(VersionCounter)</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>$(VersionMajor).$(VersionMinor).0.0</AssemblyVersion>
    <FileVersion>$(VersionMajor).$(VersionMinor).0.$(VersionCounter)</FileVersion>
    <Authors>Andreas Lucas (aka Kili)</Authors>
    <AuthorEmail>andreas.lucas@outlook.com</AuthorEmail>
    <Company>Andreas Lucas</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Kili69/HybridDeviceTagger</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kili69/HybridDeviceTagger.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Tags hybrid Active Directory devices in Microsoft Entra ID and securely rotates the directory service credential.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'HybridDeviceTagger'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>